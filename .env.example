# Variaveis do Execution Service com valores de DEMONSTRACAO (os do
# docker-compose.yml). Fora do compose: `cp .env.example .env`, ajuste e
# exporte antes de rodar (`set -a; . ./.env; set +a; make run`). Em ambiente
# exposto tudo entra por Secret.

# Banco do proprio servico: o PostgreSQL do compose publicado em 127.0.0.1:5433.
DATABASE_URL=postgresql://execucao:execucao-demo@127.0.0.1:5433/execucao  # gitleaks:allow (senha do banco de demo)
# JWKS do OS Service (chave publica dos JWT) e base do Billing (validacao de
# precos); URLs http(s) com host, conferidas no boot.
JWKS_URL=http://127.0.0.1:8000/.well-known/jwks.json
BILLING_URL=http://127.0.0.1:8002

# Pool e limites de tempo do banco (opcionais; os valores abaixo sao os padroes).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_S=5
DB_CONNECT_TIMEOUT_S=3
DB_LOCK_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000

# Mensageria (relay e consumidor; a API so grava a outbox): usuario `execucao`
# do RabbitMQ do compose (127.0.0.1:5673). No Kubernetes:
# amqp://execucao:<senha>@rabbitmq.pytstop-plataforma.svc.cluster.local:5672/
RABBITMQ_URL=amqp://execucao:pytstop-execucao-demo-2026@127.0.0.1:5673/%2F  # gitleaks:allow (senha de demo)
# Porta do /metrics do relay e do consumidor (a API serve /metrics na porta HTTP).
METRICS_PORT=9100
# Trace: o contexto W3C segue pela outbox e pelo AMQP sempre; a exportacao OTLP
# (gRPC) para o Jaeger so liga com OTEL_ENABLED=true.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=execution-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317

# entrypoint.sh da imagem: migracao e seed no boot (o compose liga os dois; no
# Kubernetes a migracao roda num Job antes do rollout).
RUN_MIGRATIONS_ON_STARTUP=false
RUN_SEED_ON_STARTUP=false

# So do compose: portas no host (127.0.0.1) e nome da imagem.
API_PORT=8003
DB_PORT=5433
RABBITMQ_PORT=5673
RABBITMQ_UI_PORT=15673
API_IMAGE=pytstop-execution-service:dev
